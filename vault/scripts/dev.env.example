# DEV-ONLY FIXTURE — do not copy these values into a real deployment.
# Matches the local Vault dev-mode server started by docker-compose-development.yml,
# whose root token is always "root". Copy to app/.env (or set in your shell) when
# running the app against that local dev Vault, never against a real instance.

# Vault connection
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root

# VaultLens server
PORT=3001
NODE_ENV=development

# Optional: system token for merge operations (same as root in dev)
VAULT_SYSTEM_TOKEN=root

# TLS (not needed for dev Vault)
VAULT_SKIP_TLS_VERIFY=false
