# VaultLens Configuration
# Copy this file to .env and adjust values

# Required: Vault server address
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root

# Required: System token for secure merge and shared secrets
VAULT_SYSTEM_TOKEN=your-vault-system-token

# Optional: Port to expose VaultLens
VAULTLENS_PORT=3001

# Optional: Skip TLS verification (NOT recommended for production)
VAULT_SKIP_TLS_VERIFY=false

# Optional: CORS origin (leave empty for same-origin)
CORS_ORIGIN=

# ── OIDC Authentication (optional) ───────────────────────────────────────────
# Fill in to enable full OIDC login in the local dev environment.
# The OIDC auth method is always enabled by bootstrap.sh; these values configure it.
# The redirect URI must match what you registered with your identity provider.
#
# OIDC_DISCOVERY_URL=https://your-idp.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_DEFAULT_ROLE=vault-admin
# OIDC_REDIRECT_URI=http://localhost:3001/oidc-callback/oidc
# OIDC_TOKEN_POLICIES=admin,vaultlens-admin
