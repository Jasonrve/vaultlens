# Server Configuration
PORT=3001
NODE_ENV=development

# Vault Configuration
VAULT_ADDR=http://127.0.0.1:8200

# System token — used for sharing and branding storage (use 'root' for local dev)
VAULT_SYSTEM_TOKEN=root

# Kubernetes auth — only needed when running in Kubernetes (replaces VAULT_SYSTEM_TOKEN)
# VAULT_K8S_AUTH_ROLE=vaultlens
# VAULT_K8S_AUTH_MOUNT defaults to: kubernetes
# VAULT_K8S_TOKEN_PATH defaults to: /var/run/secrets/kubernetes.io/serviceaccount/token

# Local downstream Kubernetes access for the development k3s fixture.
# `npm run dev` refreshes K8S_ACCESS_K3S from the local Docker fixture when it is available.
# For other clusters, use one variable per cluster name, for example K8S_ACCESS_K3S.
# K8S_ACCESS_K3S=
# K8S_SKIP_TLS_VERIFY=true

# EKS downstream cluster access via this pod's own IAM role (IRSA or EKS Pod
# Identity), instead of a static K8S_ACCESS_<MOUNT> token. Set the EKS cluster
# name per Kubernetes auth mount; region defaults to AWS_REGION/AWS_DEFAULT_REGION.
# K8S_ACCESS_<MOUNT>_EKS_CLUSTER=my-eks-cluster
# K8S_ACCESS_<MOUNT>_EKS_REGION=us-east-1

# Optional: Allow external CORS origins (comma-separated)
# CORS_ORIGIN=http://localhost:3000

# TLS Configuration
VAULT_SKIP_TLS_VERIFY=false

# Rate limiting (applied to /api/* routes only)
# RATE_LIMIT_MAX=500
# RATE_LIMIT_WINDOW_MS=900000
# SHARING_RATE_LIMIT_MAX=20

# Audit log path
# VAULT_AUDIT_LOG_PATH=/var/log/vault/audit.log

# Path for config storage (config.ini, encryption key, blobs) on disk
# VAULTLENS_CONFIG_PATH=/data/vaultlens

# Path for backup storage
# VAULTLENS_BACKUP_PATH=/data/backups

# Key used to encrypt sensitive values (e.g. the system AppRole secret_id) at rest.
# If unset, a random key is generated on first run and persisted next to config.ini.
# Set this explicitly when running multiple instances that must share decryptable
# config without relying on a shared disk (e.g. behind a load balancer).
# VAULTLENS_ENCRYPTION_KEY=
